# SaaS-Sentry backend — environment template (names only, no real values).
#
# Every line is commented out on purpose: dotenv turns `NAME=` into an empty string, which fails validation for numbers
# and most strings. Uncomment only what you override and fill in your own value.
#
# Copying this file to .env is NOT production-ready. Outside production most variables have a local default in
# src/infrastructure/config/env-schema.ts. The four secrets marked `@required-outside-test` have none: only NODE_ENV=test
# (the test runs) gets a public fallback (Owner decision E3 = C). For development, generate your own values with the
# commands below and put them in your untracked .env; the API, the worker and the recovery command refuse to start
# without them, and refuse any value that is public in this repository. With NODE_ENV=production the validator also
# refuses to start when a variable marked `@production-required` is missing.
#
# Generate each secret yourself, never reuse one from another machine or environment, and never commit .env:
#   access-token secret (>= 32 chars):  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   throttle pepper (>= 16 chars):      node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   outbox payload key (32-byte base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   (equivalent: openssl rand -base64 48 / openssl rand -base64 32)
#   outbox payload key id: any label of 1–32 characters of A-Z a-z 0-9 . _ - that names this key, e.g. dev-<yourname>-1
#
# Removed variables — delete them from your own .env files if present (they are ignored today, never read):
#   AUTH_COOKIE_SECURE  (removed in 1336bd5; refresh tokens travel in the request/response body, no cookie)
#
# src/infrastructure/config/env-example.spec.ts checks that this file lists exactly the schema's variables plus the
# module-checked and Compose-only ones below, that every assignment stays commented, that secret-like names carry no
# value, and that the `@production-required` and `@required-outside-test` markers match the validator. It never reads
# .env or .env.production.

# --- Runtime -------------------------------------------------------------------------------------------------------
# development | test | production
# NODE_ENV=
# HTTP port of the API
# PORT=
# Lowercase path segment before /v1
# API_PREFIX=
# Comma-separated allowed origins; production requires explicit HTTPS origins
# CORS_ORIGINS=
# Number of trusted reverse-proxy hops; set only behind an ingress that overwrites client headers
# TRUST_PROXY_HOPS=
# true | false; defaults to on outside production
# SWAGGER_ENABLED=

# --- Database ------------------------------------------------------------------------------------------------------
# @production-required
# postgresql://<user>:<password>@<host>:<port>/<database> — use a non-superuser runtime role
# DATABASE_URL=
# Only accepted when NODE_ENV=test; leave unset otherwise
# TEST_DATABASE_URL=
# Per-transaction limits (ms); lock < statement < transaction is enforced at startup
# DB_LOCK_TIMEOUT_MS=
# DB_STATEMENT_TIMEOUT_MS=
# DB_TRANSACTION_TIMEOUT_MS=
# DB_TRANSACTION_MAX_WAIT_MS=
# Client-side limits (ms) for a database that accepts connections but never answers
# DB_CONNECT_TIMEOUT_MS=
# DB_QUERY_TIMEOUT_MS=
# PostgreSQL idle-in-transaction backstop (ms); when unset it follows the transaction timeout
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# --- Authentication ------------------------------------------------------------------------------------------------
# @production-required
# @required-outside-test
# Random secret, at least 32 characters (see the generation command above)
# AUTH_ACCESS_TOKEN_SECRET=
# Access-token lifetime in seconds (60–3600)
# AUTH_ACCESS_TOKEN_TTL_SECONDS=
# JWT issuer and audience
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# One-time links (seconds / per hour)
# AUTH_INVITATION_TTL_SECONDS=
# AUTH_PASSWORD_RESET_TTL_SECONDS=
# AUTH_PASSWORD_RESET_MAX_PER_HOUR=

# --- Session (refresh tokens are opaque, stored as SHA-256 in PostgreSQL) -----------------------------------------
# Idle and absolute session lifetime in seconds; idle must not exceed absolute
# AUTH_SESSION_IDLE_SECONDS=
# AUTH_SESSION_ABSOLUTE_SECONDS=

# --- Rate limit ----------------------------------------------------------------------------------------------------
# Global per-route, per-IP throttler (process memory)
# RATE_LIMIT_TTL_MS=
# RATE_LIMIT_LIMIT=
# Sign-in failure throttling per normalized email
# AUTH_LOGIN_MAX_FAILURES=
# AUTH_LOGIN_WINDOW_SECONDS=
# AUTH_LOGIN_BLOCK_SECONDS=
# @production-required
# @required-outside-test
# Random HMAC pepper, at least 16 characters (see the generation command above)
# AUTH_THROTTLE_PEPPER=

# --- Object storage (mounted by the API, ADR-0014) and queue (standby, no consumer yet; E2 = A, H6.4, kept by OD-R5) ---
# The API mounts ObjectStorageModule for the files of contracts, so in production it needs the object storage variables
# below (src/infrastructure/object-storage/object-storage.config.ts): the endpoint must be HTTPS. The worker and the
# commands mount neither it nor QueueInfrastructureModule (standby infrastructure that the Owner keeps for a future
# module). A slice that mounts the queue gets its validation back
# (src/infrastructure/queue/queue.config.ts): the variables marked `@production-required-when-mounted` are then required
# in production and Redis must have a password.
#
# Object storage (S3-compatible). Outside NODE_ENV=test the access key and the secret key are required, differ from each
# other and are never the public default of MinIO (`minioadmin`): create your own.
# @production-required-when-mounted
# URL of the S3-compatible endpoint
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=
# @production-required-when-mounted
# OBJECT_STORAGE_BUCKET=
# @production-required-when-mounted
# OBJECT_STORAGE_ACCESS_KEY_ID=
# @production-required-when-mounted
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# true | false
# OBJECT_STORAGE_FORCE_PATH_STYLE=
#
# Queue (Redis, BullMQ)
# @production-required-when-mounted
# REDIS_HOST=
# REDIS_PORT=
# REDIS_USERNAME=
# @production-required-when-mounted
# REDIS_PASSWORD=
# true | false
# REDIS_TLS=

# --- AI service (the summary of the approval queue, US-15-05; checked by src/modules/ai-assist when it is mounted) ----
# Leave the address unset and the feature answers that the AI service is unavailable; the API still starts. Set it and the
# token is required. The token is the bearer token of the service (the same value the AI service reads); keep it out of
# the repository and the logs.
# Base URL of the AI service. In production it must be https, or http to this machine only (localhost, 127.0.0.0/8, ::1):
# the API refuses to start otherwise (TLS between hosts). Outside production http or https to any host
# AI_SERVICE_BASE_URL=
# AI_SERVICE_TOKEN=
# Deadline of one call, its retry included (ms, 1000-120000, default 90000)
# AI_SERVICE_TIMEOUT_MS=

# --- Mail (SMTP and the encrypted outbox) --------------------------------------------------------------------------
# @production-required
# Public URL of the web client; links in invitation and reset mail point here (HTTPS in production)
# APP_PUBLIC_URL=
# @production-required
# @required-outside-test
# Base64 of 32 random bytes (see the generation command above)
# OUTBOX_PAYLOAD_KEY=
# @production-required
# @required-outside-test
# Key identifier, 1–32 characters of A-Z a-z 0-9 . _ -
# OUTBOX_PAYLOAD_KEY_ID=
# id:base64 pairs separated by commas, only during a key rotation
# OUTBOX_PAYLOAD_PREVIOUS_KEYS=
# Worker polling interval (ms)
# OUTBOX_POLL_INTERVAL_MS=
# Worker interval over the open steps of requests (ms, 1000-300000, default 10000)
# REQUEST_WORK_INTERVAL_MS=
# @production-required
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# @production-required
# Sender address
# SMTP_FROM=
# true | false
# SMTP_TLS=

# --- License key vault (license keys kept encrypted at rest, QĐ-54b) ----------------------------------------------
# @production-required
# @required-outside-test
# Base64 of 32 random bytes (see the generation command above); a different value from OUTBOX_PAYLOAD_KEY
# LICENSE_KEY_VAULT_KEY=
# @production-required
# @required-outside-test
# Key identifier, 1–32 characters of A-Z a-z 0-9 . _ -
# LICENSE_KEY_VAULT_KEY_ID=
# @production-required
# @required-outside-test
# At least 16 random characters; it makes the fingerprints that find a repeated key, so never rotate it with the key
# LICENSE_KEY_FINGERPRINT_PEPPER=
# id:base64 pairs separated by commas, only during a key rotation
# LICENSE_KEY_VAULT_PREVIOUS_KEYS=

# --- Docker Compose only (read by compose.yaml / docker-compose.prod.yml, not by the application) -------------------
# In production these live in the `.env` beside docker-compose.prod.yml, which Compose reads for interpolation only; the
# application settings above go to `.env.app`, the only file the API and the worker read. Never put a POSTGRES_* or
# DATABASE_DEPLOY_* value in `.env.app`: in production the API and the worker refuse to start with one (H7,
# docs/guides/containers.md#postgresql-roles-h7). Role passwords: 32+ characters, e.g. `openssl rand -hex 32`.
# Cluster superuser of the PostgreSQL image: provisions the roles (`ops:db-roles provision`), never used by the API
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=
# Deploy role (default slm_deploy): owns the schema; backup, preflight, migrate, reconcile
# DATABASE_DEPLOY_USER=
# DATABASE_DEPLOY_PASSWORD=
# Runtime role (default slm_runtime): the API and the worker
# DATABASE_RUNTIME_USER=
# DATABASE_RUNTIME_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_PORT=
# MINIO_CONSOLE_PORT=
# DOMAIN=
