{
  "name": "software-license-management",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm prisma:generate && nest build && node scripts/build/emit-cli-aliases.mjs",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs,cjs}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs,cjs}\" \"*.{json,md}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker",
    "ops:bootstrap": "node dist/cli bootstrap",
    "ops:recover": "node dist/cli recover",
    "ops:record-super-admin-event": "node dist/cli record-super-admin-event",
    "ops:inspect": "node dist/cli inspect",
    "ops:preflight": "node dist/cli preflight",
    "ops:ai-purge": "node dist/cli ai-purge",
    "ops:assign-subscription-owner": "node dist/cli assign-subscription-owner",
    "ops:cost-center-direction": "node dist/cli cost-center-direction",
    "ops:db-roles": "node dist/cli db-roles",
    "ops:seed": "node dist/cli seed",
    "seed:local": "node scripts/dev/seed-local.mjs",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:prune": "eslint \"{src,test,scripts}/**/*.ts\" --prune-suppressions",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "openapi:export": "ts-node scripts/dev/export-openapi.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "arch:graph": "node scripts/arch/graph.mjs",
    "arch:routes": "node scripts/arch/routes.mjs",
    "arch:capabilities": "node scripts/arch/capabilities.mjs",
    "arch:docs:check": "node scripts/arch/graph.mjs --check && node scripts/arch/routes.mjs --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:gates": "jest --config ./test/config/jest.gates.cjs",
    "test:http": "jest --config ./test/config/jest.http.cjs",
    "test:e2e": "jest --config ./test/config/jest.e2e.cjs --runInBand",
    "test:flows": "node scripts/verify/run-flows.mjs",
    "test:integration": "jest --config ./test/config/jest.integration.cjs",
    "test:integration:serial": "jest --config ./test/config/jest.integration-serial.cjs --runInBand",
    "test:integration:timing": "jest --config ./test/config/jest.integration-timing.cjs --runInBand --passWithNoTests",
    "test:discovery": "node scripts/verify/verify-test-discovery.mjs",
    "test:scripts": "node --test \"scripts/verify/*.test.mjs\"",
    "test:mutation": "node scripts/verify/targeted-mutation.mjs",
    "check": "pnpm rules:check && pnpm rules:test && pnpm rules:format && pnpm format:check && pnpm prisma:validate && pnpm prisma:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm test:gates && pnpm arch:check && pnpm arch:docs:check && pnpm test:scripts && pnpm test:discovery && pnpm build",
    "rules:check": "node scripts/check-rules.mjs",
    "rules:test": "node --test scripts/check-rules.test.mjs",
    "rules:format": "prettier --check README.md CONTRIBUTING.md ARCHITECTURE.md AGENTS.md CLAUDE.md GEMINI.md .github/copilot-instructions.md docs/README.md docs/roadmap.md \"docs/workspace/**/*.md\" \"!docs/workspace/local/**\" \"docs/rules/*.md\" docs/guides/ai-tools.md docs/guides/containers.md docs/guides/bootstrap-installation.md docs/guides/demo-dataset.md docs/guides/seed.md docs/guides/huong-dan-dev-moi.md docs/reviews/backend-baseline-review.md docs/reviews/be-architecture-test-acceptance-2026-10-29/README.md test/README.md test/support/README.md src/README.md docs/guides/runtime-details.md \"src/modules/*/README.md\" scripts/README.md \"scripts/check-rules*.mjs\" rules-check.config.json .github/workflows/ci.yml && prettier --check --parser markdown .windsurfrules \".cursor/rules/*.mdc\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.11",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.1.7",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@huggingface/transformers": "3.8.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.21.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-environment-node": "30.4.1",
    "prettier": "^3.4.2",
    "smtp-server": "3.19.15",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/generated/**",
      "!src/**/*.spec.ts",
      "!src/main.ts",
      "!src/worker.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "<rootDir>/test/config/timing-reporter.cjs",
        {
          "runner": "unit"
        }
      ]
    ]
  }
}
