enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Transactional outbox: written in the same transaction as the business change, delivered by
// the worker. action_token_hash is a plain value (no foreign key): this module never reads the
// identity tables; the dispatcher asks identity-access whether the token is still usable. It is
// null for a notice with no link (password changed); PostgreSQL lets any number of NULLs share a
// unique index, so only real token hashes stay unique.
model EmailOutbox {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  recipient         String
  template          String
  locale            String
  actionTokenHash   String?           @unique @map("action_token_hash")
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  nextAttemptAt     DateTime          @map("next_attempt_at") @db.Timestamptz(3)
  leaseId           String?           @map("lease_id") @db.Uuid
  leaseExpiresAt    DateTime?         @map("lease_expires_at") @db.Timestamptz(3)
  payloadCiphertext Bytes?            @map("payload_ciphertext")
  payloadKeyId      String?           @map("payload_key_id")
  lastErrorCode     String?           @map("last_error_code")
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// The notice a person reads inside the application (FR-3.11, US-05-15 AC-7, AC-10): written in the transaction of the caller,
// so it exists exactly when the change behind it commits, and read by web and mobile through the same route. It is a value
// like `email_outbox`: the recipient is an employee id with no foreign key, because the history outlives the account. What it
// says is a code and flat parameters; the interface turns them into words, so no name or amount is copied here (INF-06).
// One row for each (recipient, event key): writing it again is a no-op. Only `read_at` ever changes, once; nothing is deleted.
model InAppNotification {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  recipientEmployeeId String    @map("recipient_employee_id") @db.Uuid
  code                String
  // What the notice is about (a request, a return), by id; both or neither.
  subjectType         String?   @map("subject_type")
  subjectId           String?   @map("subject_id") @db.Uuid
  params              Json      @default("{}")
  eventKey            String    @map("event_key")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt              DateTime? @map("read_at") @db.Timestamptz(3)

  @@unique([recipientEmployeeId, eventKey])
  @@index([recipientEmployeeId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("in_app_notifications")
}

// A notice kept for a department that has no head yet (F67, T-11): written when the event happens, handed to the first head
// the Super Admin names, once, in the transaction of that assignment. `event_key` makes writing it again a no-op.
model HeldDepartmentNotification {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  departmentId          String    @map("department_id") @db.Uuid
  code                  String
  subjectType           String?   @map("subject_type")
  subjectId             String?   @map("subject_id") @db.Uuid
  params                Json      @default("{}")
  eventKey              String    @unique @map("event_key")
  heldAt                DateTime  @default(now()) @map("held_at") @db.Timestamptz(3)
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(3)
  // A value: the head it was handed to (the history outlives the post).
  deliveredToEmployeeId String?   @map("delivered_to_employee_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([departmentId, deliveredAt])
  @@map("held_department_notifications")
}
