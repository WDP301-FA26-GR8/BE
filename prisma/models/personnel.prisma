// The personnel context (ADR-0017): what happens to the place of a person in the organization, with the day it takes effect and
// the basis it rests on. The placements and head periods a transfer writes belong to organization; this context keeps the
// record of the transfer and what became of it.

enum DepartmentTransferStatus {
  PENDING
  EFFECTIVE
  CANCELLED
}

enum DepartmentTransferChangeKind {
  RESCHEDULED
  CANCELLED
}

// A change of department or job title with a day it takes effect. The periods are written when it is recorded; a transfer is
// PENDING until its day, then EFFECTIVE, or CANCELLED. At most one is PENDING for each employee (a partial unique index).
model DepartmentTransfer {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  employeeId           String                   @map("employee_id") @db.Uuid
  fromDepartmentId     String                   @map("from_department_id") @db.Uuid
  toDepartmentId       String                   @map("to_department_id") @db.Uuid
  // The titles the catalogue gave the person before it was removed: history only, read by nothing (`@ignore`).
  fromJobTitleName     String?                  @map("from_job_title_name") @ignore
  toJobTitleName       String?                  @map("to_job_title_name") @ignore
  effectiveOn          DateTime                 @map("effective_on") @db.Date
  status               DepartmentTransferStatus @default(PENDING)
  closesPlacementId    String                   @map("closes_placement_id") @db.Uuid
  opensPlacementId     String                   @map("opens_placement_id") @db.Uuid
  headHandover         Json?                    @map("head_handover")
  groundsType          String?                   @map("grounds_type")
  groundsReference     String                   @map("grounds_reference")
  groundsIssuer        String?                   @map("grounds_issuer")
  groundsIssuedOn      DateTime?                 @map("grounds_issued_on") @db.Date
  selfExecuted         Boolean                  @default(false) @map("self_executed") @ignore
  // Who recorded and who cancelled: an application account OR the ticket of the controlled procedure (spec L.2).
  recordedByAppUserId  String?                  @map("recorded_by_app_user_id") @db.Uuid
  recordedByTicketId   String?                  @map("recorded_by_ticket_id") @db.Uuid
  recordedAt           DateTime                 @default(now()) @map("recorded_at") @db.Timestamptz(3)
  effectiveAt          DateTime?                @map("effective_at") @db.Timestamptz(3)
  cancelledAt          DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  cancelledByAppUserId String?                  @map("cancelled_by_app_user_id") @db.Uuid
  cancelledByTicketId  String?                  @map("cancelled_by_ticket_id") @db.Uuid
  cancelledReason      String?                  @map("cancelled_reason")
  // Closed once every right of the old department is taken back (`QĐ-110r`): by the system (`closedBySystem`, no account), or, for a
  // transfer closed before that rule, by an IT Admin (`closedByAppUserId`); only an EFFECTIVE transfer.
  closedAt             DateTime?                @map("closed_at") @db.Timestamptz(3)
  closedByAppUserId    String?                  @map("closed_by_app_user_id") @db.Uuid
  closedBySystem       Boolean                  @default(false) @map("closed_by_system")
  // A departure recorded while the grace lasts takes the old rights over and closes the transfer (`QĐ-110r`, MF3-C.2): the case that did. Only on a transfer closed by the system.
  supersededByCaseId   String?                  @map("superseded_by_case_id") @db.Uuid
  // The grace of the old rights (`QĐ-110p`, MF3-B): the last day the person keeps them, the day they are told once more, and when that was
  // done; set once, when the transfer takes effect. A transfer that took effect before the release has them from the day of the release.
  graceEndsOn          DateTime?                @map("grace_ends_on") @db.Date
  graceReminderOn      DateTime?                @map("grace_reminder_on") @db.Date
  remindedAt           DateTime?                @map("reminded_at") @db.Timestamptz(3)
  // The rights the person held when the transfer took effect, and, when it closes, what is left of them (codecs in `transfer-snapshot.json.ts`).
  snapshotBefore       Json?                    @map("snapshot_before")
  snapshotAfter        Json?                    @map("snapshot_after")
  // The notice of a head this transfer was recorded from, when there was one (US-03-11).
  noticeId             String?                  @unique @map("notice_id") @db.Uuid

  organization      Organization               @relation(fields: [organizationId], references: [id])
  notice            PersonnelNotice?           @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  supersededByCase  OffboardingCase?           @relation("TransferSupersededByCase", fields: [supersededByCaseId], references: [id], onDelete: Restrict)
  employee          Employee                   @relation(fields: [employeeId], references: [id])
  fromDepartment    Department                 @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment      Department                 @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])
  recordedByTicket  SuperAdminEventTicket?     @relation("TransferRecordedByTicket", fields: [recordedByTicketId], references: [id], onDelete: Restrict)
  cancelledByTicket SuperAdminEventTicket?     @relation("TransferCancelledByTicket", fields: [cancelledByTicketId], references: [id], onDelete: Restrict)
  changes           DepartmentTransferChange[]
  reviews           TransferReview[]
  itAdminHandover   ItAdminHandover?

  @@index([effectiveOn(sort: Desc), id])
  @@index([employeeId])
  @@index([organizationId])
  @@map("department_transfers")
}

// One row for each move of the day or cancellation of a transfer that had not taken effect. Append-only (a trigger).
model DepartmentTransferChange {
  id                 String                       @id @default(uuid(7)) @db.Uuid
  transferId         String                       @map("transfer_id") @db.Uuid
  kind               DepartmentTransferChangeKind
  oldEffectiveOn     DateTime                     @map("old_effective_on") @db.Date
  newEffectiveOn     DateTime?                    @map("new_effective_on") @db.Date
  reason             String
  groundsType        String?                       @map("grounds_type")
  groundsReference   String                       @map("grounds_reference")
  groundsIssuer      String?                       @map("grounds_issuer")
  groundsIssuedOn    DateTime?                     @map("grounds_issued_on") @db.Date
  changedByAppUserId String?                      @map("changed_by_app_user_id") @db.Uuid
  changedByTicketId  String?                      @map("changed_by_ticket_id") @db.Uuid
  changedAt          DateTime                     @default(now()) @map("changed_at") @db.Timestamptz(3)

  transfer        DepartmentTransfer     @relation(fields: [transferId], references: [id])
  changedByTicket SuperAdminEventTicket? @relation("TransferChangeByTicket", fields: [changedByTicketId], references: [id], onDelete: Restrict)

  @@index([transferId, changedAt, id])
  @@map("department_transfer_changes")
}

enum TransferReviewStatus {
  OPEN
  COMPLETED
  SUPERSEDED
}

enum TransferReviewDecision {
  PENDING
  STILL_NEEDED
  NOT_NEEDED
  NEEDS_NEW_TOOL
}

// The review a new head makes of the tools a person brought from another department that are outside the standard toolset of the
// department and job title they came to (US-03-07): one for each placement a transfer opened, OPEN until every line is decided
// (COMPLETED) or a later transfer of the person makes it obsolete (SUPERSEDED). Who decides is the head of the department
// today, read from the organization. Never reopened; identity columns fixed (a trigger).
model TransferReview {
  id               String               @id @default(uuid(7)) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  employeeId       String               @map("employee_id") @db.Uuid
  transferId       String?              @map("transfer_id") @db.Uuid
  placementId      String               @unique @map("placement_id") @db.Uuid
  departmentId     String               @map("department_id") @db.Uuid
  // The title the catalogue gave the period before it was removed: history only, read by nothing (`@ignore`).
  jobTitleName     String?              @map("job_title_name") @ignore
  effectiveOn      DateTime             @map("effective_on") @db.Date
  dueOn            DateTime             @map("due_on") @db.Date
  status           TransferReviewStatus @default(OPEN)
  openedAt         DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz(3)
  overdueNoticedAt DateTime?            @map("overdue_noticed_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id])
  employee     Employee             @relation("TransferReviewEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  transfer     DepartmentTransfer?  @relation(fields: [transferId], references: [id], onDelete: Restrict)
  placement    EmployeePlacement    @relation(fields: [placementId], references: [id], onDelete: Restrict)
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  items        TransferReviewItem[]

  @@index([dueOn, id])
  @@index([employeeId])
  @@index([departmentId])
  @@map("transfer_reviews")
}

// One tool outside the standard toolset, with the decision about it. Written once: a trigger refuses to change a decided line, and
// the checks keep the decision, the person, the moment, the note and the revocation of the line together (migration).
model TransferReviewItem {
  reviewId            String                 @map("review_id") @db.Uuid
  assignmentId        String                 @map("assignment_id") @db.Uuid
  planId              String                 @map("plan_id") @db.Uuid
  position            Int
  grantReason         String?                @map("grant_reason")
  decision            TransferReviewDecision @default(PENDING)
  decidedByEmployeeId String?                @map("decided_by_employee_id") @db.Uuid
  decidedAt           DateTime?              @map("decided_at") @db.Timestamptz(3)
  newToolNote         String?                @map("new_tool_note")
  // Why the head said the tool is still needed or no longer needed (1..500); null for a line decided before it was asked for.
  reason              String?
  revocationTaskId    String?                @map("revocation_task_id") @db.Uuid

  review         TransferReview    @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  assignment     LicenseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  decidedBy      Employee?         @relation("TransferReviewDecidedBy", fields: [decidedByEmployeeId], references: [id], onDelete: Restrict)
  revocationTask ProvisioningTask? @relation(fields: [revocationTaskId], references: [id], onDelete: Restrict)

  @@id([reviewId, assignmentId])
  @@index([assignmentId])
  @@map("transfer_review_items")
}

enum EmployeeLeaveStatus {
  ACTIVE
  ENDED
}

enum EmployeeLeaveEndKind {
  RETURNED
  DEPARTURE_STARTED
}

enum EmployeeLeaveChangeKind {
  STARTED
  RETURN_DATE_CHANGED
  RETURNED
  ENDED_FOR_DEPARTURE
  RESUMED
}

// One period of long leave (US-03-03): the day the person is due back and the basis of that day, ACTIVE until the person comes
// back or a handover for leaving begins (ENDED). At most one is ACTIVE for each employee (a partial unique index). No column keeps
// the reason for the leave and none keeps medical data. Only the approved day with its basis, the mark of the reminder and the end
// change (a trigger); an ended leave never does.
model EmployeeLeave {
  id                      String                @id @default(uuid(7)) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  employeeId              String                @map("employee_id") @db.Uuid
  startedOn               DateTime              @map("started_on") @db.Date
  approvedReturnOn        DateTime              @map("approved_return_on") @db.Date
  status                  EmployeeLeaveStatus   @default(ACTIVE)
  endedOn                 DateTime?             @map("ended_on") @db.Date
  endKind                 EmployeeLeaveEndKind? @map("end_kind")
  resumesLeaveId          String?               @map("resumes_leave_id") @db.Uuid
  groundsType             String?                @map("grounds_type")
  groundsReference        String                @map("grounds_reference")
  groundsIssuer           String?                @map("grounds_issuer")
  groundsIssuedOn         DateTime?              @map("grounds_issued_on") @db.Date
  startedByAppUserId      String?               @map("started_by_app_user_id") @db.Uuid
  startedByTicketId       String?               @map("started_by_ticket_id") @db.Uuid
  startedAt               DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  selfExecuted            Boolean               @default(false) @map("self_executed") @ignore
  returnOverdueNoticedFor DateTime?             @map("return_overdue_noticed_for") @db.Date
  // The notice of a head this leave was recorded from, when there was one (US-03-11).
  noticeId                String?               @unique @map("notice_id") @db.Uuid

  organization    Organization           @relation(fields: [organizationId], references: [id])
  notice          PersonnelNotice?       @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  employee        Employee               @relation(fields: [employeeId], references: [id])
  resumes         EmployeeLeave?         @relation("EmployeeLeaveResumed", fields: [resumesLeaveId], references: [id], onDelete: Restrict)
  resumedBy       EmployeeLeave[]        @relation("EmployeeLeaveResumed")
  changes         EmployeeLeaveChange[]
  startedByTicket SuperAdminEventTicket? @relation("LeaveStartedByTicket", fields: [startedByTicketId], references: [id], onDelete: Restrict)

  @@index([approvedReturnOn, id])
  @@index([employeeId, startedOn])
  @@index([organizationId])
  @@map("employee_leaves")
}

// What happened to a leave, one row for each event. Append-only (a trigger). The basis is kept whole or not at all.
model EmployeeLeaveChange {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  leaveId             String                  @map("leave_id") @db.Uuid
  kind                EmployeeLeaveChangeKind
  oldReturnOn         DateTime?               @map("old_return_on") @db.Date
  newReturnOn         DateTime?               @map("new_return_on") @db.Date
  returnedOn          DateTime?               @map("returned_on") @db.Date
  onSchedule          Boolean?                @map("on_schedule")
  groundsType         String?                 @map("grounds_type")
  groundsReference    String?                 @map("grounds_reference")
  groundsIssuer       String?                 @map("grounds_issuer")
  groundsIssuedOn     DateTime?               @map("grounds_issued_on") @db.Date
  recordedByAppUserId String?                 @map("recorded_by_app_user_id") @db.Uuid
  recordedByTicketId  String?                 @map("recorded_by_ticket_id") @db.Uuid
  recordedAt          DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(3)
  selfExecuted        Boolean                 @default(false) @map("self_executed") @ignore

  leave            EmployeeLeave          @relation(fields: [leaveId], references: [id], onDelete: Restrict)
  recordedByTicket SuperAdminEventTicket? @relation("LeaveChangeByTicket", fields: [recordedByTicketId], references: [id], onDelete: Restrict)

  @@index([leaveId, recordedAt, id])
  @@map("employee_leave_changes")
}

// How the access of the person is blocked (QĐ-96c): from the day after the last working day, or from the day the departure is recorded.
enum OffboardingAccessBlockMode {
  WITH_LAST_DAY
  BLOCK_NOW
}

enum OffboardingState {
  HANDING_OVER
  LEFT
  CANCELLED
}

// The roles a person who leaves holds that someone must take over: a snapshot for the filter of the list, never a decision.
enum OffboardingRoleFlag {
  SUPER_ADMIN_HOLDER
  FINANCE
  SPENDING_APPROVER
  SUBSTITUTE_APPROVER
  FALLBACK_APPROVER
  IT_ADMIN_IN_CHARGE
  DEPARTMENT_HEAD
  WORKSPACE_OWNER
}

enum OffboardingChangeKind {
  RECORDED
  LAST_DAY_CHANGED
  CANCELLED
  MARKED_LEFT
  ACCOUNT_LOCK_RECORDED
  REVOCATIONS_OPENED
  CLOSED
  // The system blocked the person's access at the block moment (QĐ-110b, QĐ-110d).
  ACCESS_BLOCKED
  // A cancellation after the last day withdrew the revocation tasks not yet done (QĐ-110c, R-41).
  REVOCATIONS_WITHDRAWN
  // An IT Admin moved every subscription and application the leaver answered for to another IT Admin (QĐ-110j).
  IT_ADMIN_HANDED_OVER
  // The system closed the case: gone, every revocation done, the mailbox locked for good (QĐ-110e).
  CLOSED_BY_SYSTEM
  // The IT Admin recorded item (1b) of BM-08, the mailbox locked for good (B-1).
  MAILBOX_LOCKED
}

// The record of a person who leaves, from the day it is written until it is closed (g6-offboarding-record): a planned handover
// with a last working day (HANDING_OVER) that ends as LEFT or CANCELLED; one blocked now with a last working day that is past is LEFT at once. At most one
// live case (HANDING_OVER or LEFT) for each employee. The periods the case wrote (the placement, the head of the department) are
// named here so a move or a cancellation puts them back exactly; the basis never changes after it is written.
model OffboardingCase {
  id                     String                @id @default(uuid(7)) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  employeeId             String                @map("employee_id") @db.Uuid
  departmentId           String?               @map("department_id") @db.Uuid
  cancelledPlacementId   String?               @map("cancelled_placement_id") @db.Uuid
  cancelledPlacementDepartmentId String?       @map("cancelled_placement_department_id") @db.Uuid
  cancelledPlacementFrom DateTime?             @map("cancelled_placement_from") @db.Date
  state                  OffboardingState      @default(HANDING_OVER)
  accessBlockMode        OffboardingAccessBlockMode @map("access_block_mode")
  priorWorkState         EmployeeWorkState     @map("prior_work_state")
  lastWorkingDay         DateTime              @map("last_working_day") @db.Date
  departureEffectiveOn   DateTime              @map("departure_effective_on") @db.Date
  handoverDueOn          DateTime?             @map("handover_due_on") @db.Date
  // The day the IT Admin has until to take every right of the person away (QĐ-110c, M-09): null for a case that was closed or cancelled before the rule.
  revocationDueOn        DateTime?             @map("revocation_due_on") @db.Date
  // The moment the system announced that the access of the person is blocked (QĐ-110b, QĐ-110d): set once by the sweeper of the block moment, which is what keeps it from telling twice.
  blockAnnouncedAt       DateTime?             @map("block_announced_at") @db.Timestamptz(3)
  // The moment the system told that the lock of the company account of a departure blocked now is late (QĐ-94m(12), R-1): set once, so the telling is once for the case whoever the recipients are.
  accountLockOverdueAt   DateTime?             @map("account_lock_overdue_at") @db.Timestamptz(3)
  groundsType            String?                @map("grounds_type")
  groundsReference       String                @map("grounds_reference")
  groundsIssuer          String?                @map("grounds_issuer")
  groundsIssuedOn        DateTime?              @map("grounds_issued_on") @db.Date
  headHandover           Json?                 @map("head_handover")
  placementClosedId      String?               @map("placement_closed_id") @db.Uuid
  leftOn                 DateTime?             @map("left_on") @db.Date
  leftAt                 DateTime?             @map("left_at") @db.Timestamptz(3)
  leftByAppUserId        String?               @map("left_by_app_user_id") @db.Uuid
  cancelledAt            DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByAppUserId   String?               @map("cancelled_by_app_user_id") @db.Uuid
  cancelledByTicketId    String?               @map("cancelled_by_ticket_id") @db.Uuid
  cancelReason           String?               @map("cancel_reason")
  accountLockByAppUserId String?               @map("account_lock_by_app_user_id") @db.Uuid
  accountLockAt          DateTime?             @map("account_lock_at") @db.Timestamptz(3)
  accountLockNote        String?               @map("account_lock_note")
  // Item (1b) of BM-08, the lock of the mailbox for good (B-1): written once after (1a), by an IT Admin or, with no account, by the system when the last K1 revocation is ticked (MF2-G).
  mailboxLockAt          DateTime?             @map("mailbox_lock_at") @db.Timestamptz(3)
  mailboxLockByAppUserId String?               @map("mailbox_lock_by_app_user_id") @db.Uuid
  mailboxLockNote        String?               @map("mailbox_lock_note")
  closedAt               DateTime?             @map("closed_at") @db.Timestamptz(3)
  // Null when the system closed the case (QĐ-110e): every revocation done and (1b) written.
  closedByAppUserId      String?               @map("closed_by_app_user_id") @db.Uuid
  selfExecuted           Boolean               @default(false) @map("self_executed") @ignore
  recordedByAppUserId    String?               @map("recorded_by_app_user_id") @db.Uuid
  recordedByTicketId     String?               @map("recorded_by_ticket_id") @db.Uuid
  recordedAt             DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  // The roles the person held when the case was written or the day it moved (g6-leaver-role-and-workspace-duties); a snapshot.
  roleFlags              OffboardingRoleFlag[] @default([]) @map("role_flags")
  // The notice of a head this case was recorded from, when there was one (US-03-11).
  noticeId               String?               @unique @map("notice_id") @db.Uuid

  organization      Organization            @relation(fields: [organizationId], references: [id])
  notice            PersonnelNotice?        @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  employee          Employee                @relation(fields: [employeeId], references: [id])
  department                   Department?             @relation("OffboardingCaseDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  cancelledPlacementDepartment Department?             @relation("OffboardingCaseCancelledPlacementDepartment", fields: [cancelledPlacementDepartmentId], references: [id], onDelete: Restrict)
  changes           OffboardingCaseChange[]
  recordedByTicket  SuperAdminEventTicket?  @relation("OffboardingRecordedByTicket", fields: [recordedByTicketId], references: [id], onDelete: Restrict)
  cancelledByTicket SuperAdminEventTicket?  @relation("OffboardingCancelledByTicket", fields: [cancelledByTicketId], references: [id], onDelete: Restrict)
  supersededTransfers DepartmentTransfer[]  @relation("TransferSupersededByCase")
  itAdminHandover   ItAdminHandover?

  @@index([lastWorkingDay, id])
  @@index([employeeId])
  @@index([state, lastWorkingDay, id])
  @@index([organizationId])
  @@index([cancelledPlacementDepartmentId])
  @@index([roleFlags], type: Gin)
  @@map("offboarding_cases")
}

// What happened to a case, one row for each event. Append-only (a trigger).
model OffboardingCaseChange {
  id                 String                @id @default(uuid(7)) @db.Uuid
  caseId             String                @map("case_id") @db.Uuid
  kind               OffboardingChangeKind
  oldLastWorkingDay  DateTime?             @map("old_last_working_day") @db.Date
  newLastWorkingDay  DateTime?             @map("new_last_working_day") @db.Date
  reason             String?
  detail             Json?
  changedByAppUserId String?               @map("changed_by_app_user_id") @db.Uuid
  changedByTicketId  String?               @map("changed_by_ticket_id") @db.Uuid
  changedAt          DateTime              @default(now()) @map("changed_at") @db.Timestamptz(3)
  selfExecuted       Boolean               @default(false) @map("self_executed") @ignore

  offboardingCase OffboardingCase        @relation(fields: [caseId], references: [id], onDelete: Restrict)
  changedByTicket SuperAdminEventTicket? @relation("OffboardingChangeByTicket", fields: [changedByTicketId], references: [id], onDelete: Restrict)

  @@index([caseId, changedAt, id])
  @@map("offboarding_case_changes")
}

enum PersonnelNoticeKind {
  DEPARTMENT_TRANSFER_OUT
  DEPARTMENT_TRANSFER_IN
  JOB_TITLE_CHANGE
  DEPARTURE
  ABRUPT_DEPARTURE
  LONG_LEAVE
}

enum PersonnelNoticeStatus {
  PENDING_VERIFICATION
  RECORDED
  REJECTED
  WITHDRAWN
}

enum VerificationMethod {
  ATTACHED_DOCUMENT
  EMAIL_FROM_ISSUER
  DIRECT_CONTACT
}

enum PersonnelNoticeEventKind {
  DEPARTMENT_TRANSFER
  LONG_LEAVE
  OFFBOARDING_CASE
}

// The notice (BM-09) of a department head about a change coming for one of their people (US-03-10): information with no legal
// effect, PENDING_VERIFICATION until the IT Admin rejects it, records the event it announces or the head withdraws it. At most one
// waiting for each employee and kind (a partial unique index). The code `BM09-<year>-<six digits>` is never a basis. What it says
// never changes and a handled notice never changes again (a trigger); no column keeps a reason for leaving.
model PersonnelNotice {
  id                       String                    @id @default(uuid(7)) @db.Uuid
  code                     String                    @unique
  organizationId           String                    @map("organization_id") @db.Uuid
  employeeId               String                    @map("employee_id") @db.Uuid
  kind                     PersonnelNoticeKind
  proposedOn               DateTime                  @map("proposed_on") @db.Date
  targetDepartmentId       String?                   @map("target_department_id") @db.Uuid
  note                     String?
  senderEmployeeId         String                    @map("sender_employee_id") @db.Uuid
  senderDepartmentId       String                    @map("sender_department_id") @db.Uuid
  status                   PersonnelNoticeStatus     @default(PENDING_VERIFICATION)
  rejectReason             String?                   @map("reject_reason")
  recordedEventKind        PersonnelNoticeEventKind? @map("recorded_event_kind")
  recordedEventId          String?                   @map("recorded_event_id") @db.Uuid
  defaultItAdminEmployeeId String?                   @map("default_it_admin_employee_id") @db.Uuid
  dueOn                    DateTime                  @map("due_on") @db.Date
  handledByAppUserId       String?                   @map("handled_by_app_user_id") @db.Uuid
  handledByTicketId        String?                   @map("handled_by_ticket_id") @db.Uuid
  handledAt                DateTime?                 @map("handled_at") @db.Timestamptz(3)
  overdueNoticedAt         DateTime?                 @map("overdue_noticed_at") @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization     Organization                 @relation(fields: [organizationId], references: [id])
  employee         Employee                     @relation("NoticeAbout", fields: [employeeId], references: [id])
  sender           Employee                     @relation("NoticeSender", fields: [senderEmployeeId], references: [id])
  targetDepartment Department?                  @relation("NoticeTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: Restrict)
  senderDepartment Department                   @relation("NoticeSenderDepartment", fields: [senderDepartmentId], references: [id])
  handledByTicket  SuperAdminEventTicket?       @relation("NoticeHandledByTicket", fields: [handledByTicketId], references: [id], onDelete: Restrict)
  verification     PersonnelNoticeVerification?
  transfer         DepartmentTransfer?
  leave            EmployeeLeave?
  offboardingCase  OffboardingCase?

  @@index([status, dueOn, id])
  @@index([senderEmployeeId, createdAt, id])
  @@index([employeeId])
  @@index([organizationId])
  @@map("personnel_notices")
}

// What the IT Admin checked before a notice was recorded: one row for each recorded notice, written once and never changed.
model PersonnelNoticeVerification {
  id                  String             @id @default(uuid(7)) @db.Uuid
  noticeId            String             @unique @map("notice_id") @db.Uuid
  method              VerificationMethod
  reference           String
  verifiedByAppUserId String?            @map("verified_by_app_user_id") @db.Uuid
  verifiedByTicketId  String?            @map("verified_by_ticket_id") @db.Uuid
  verifiedAt          DateTime           @default(now()) @map("verified_at") @db.Timestamptz(3)

  notice           PersonnelNotice        @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  verifiedByTicket SuperAdminEventTicket? @relation("VerificationByTicket", fields: [verifiedByTicketId], references: [id], onDelete: Restrict)

  @@map("personnel_notice_verifications")
}

// The modes of the controlled procedure for an event whose subject is the Super Admin (`pnpm ops:record-super-admin-event`).
enum SuperAdminEventMode {
  TRANSFER_RECORD
  TRANSFER_RESCHEDULE
  TRANSFER_CANCEL
  LEAVE_START
  LEAVE_RETURN
  DEPARTURE_RECORD
  DEPARTURE_CHANGE
  DEPARTURE_CANCEL
  ABRUPT_DEPARTURE_RECORD
  PROFILE_CORRECT
}

// The approval ticket of one run of the controlled procedure (spec L.2): the idempotency key, the record of who approved and
// who ran it, and the "who" of the event it wrote in place of an application account. Added to, never changed (a trigger).
model SuperAdminEventTicket {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  ticketRef         String              @map("ticket_ref")
  mode              SuperAdminEventMode
  subjectEmployeeId String              @map("subject_employee_id") @db.Uuid
  // SHA-256 of the normalized parameters of the mode: the same ticket with other parameters is refused.
  parametersDigest  String              @map("parameters_digest")
  approverRef       String              @map("approver_ref")
  operatorRef       String              @map("operator_ref")
  environment       String
  recordedAt        DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization         Organization                  @relation(fields: [organizationId], references: [id])
  subject              Employee                      @relation("SuperAdminEventTicketSubject", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  transfersRecorded    DepartmentTransfer[]          @relation("TransferRecordedByTicket")
  transfersCancelled   DepartmentTransfer[]          @relation("TransferCancelledByTicket")
  transferChanges      DepartmentTransferChange[]    @relation("TransferChangeByTicket")
  leavesStarted        EmployeeLeave[]               @relation("LeaveStartedByTicket")
  leaveChanges         EmployeeLeaveChange[]         @relation("LeaveChangeByTicket")
  offboardingRecorded  OffboardingCase[]             @relation("OffboardingRecordedByTicket")
  offboardingCancelled OffboardingCase[]             @relation("OffboardingCancelledByTicket")
  offboardingChanges   OffboardingCaseChange[]       @relation("OffboardingChangeByTicket")
  noticesHandled       PersonnelNotice[]             @relation("NoticeHandledByTicket")
  noticeVerifications  PersonnelNoticeVerification[] @relation("VerificationByTicket")

  @@unique([organizationId, ticketRef])
  @@index([subjectEmployeeId])
  @@map("super_admin_event_tickets")
}

// The last number of the `BM09-<year>-<6 digits>` code given in a year (F48). The application takes the next one under the lock
// of the row of the year, so the series restarts every year and never runs out of the old sequence's six digits.
model PersonnelNoticeCounter {
  year      Int @id
  lastValue Int @map("last_value")

  @@map("personnel_notice_counters")
}

// What an IT Admin who leaves still answers for in the catalog (the subscriptions and the applications that name them responsible), kept once
// when the departure or the transfer is recorded (`QĐ-110j`, `QĐ-111g`, `R-8`, `R-26`, X-IT.3), and the one hand-over of all of it that an IT
// Admin makes (the latest one is kept): to whom, when, and how many were moved. Exactly one of the two sources; each has at most one row. A row exists only when the
// person answered for something when the file was recorded. It never blocks the closing of the file (`QĐ-110e`).
model ItAdminHandover {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  offboardingCaseId     String?   @unique @map("offboarding_case_id") @db.Uuid
  departmentTransferId  String?   @unique @map("department_transfer_id") @db.Uuid
  subscriptionsAtRecord Int       @map("subscriptions_at_record")
  applicationsAtRecord  Int       @map("applications_at_record")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Set together when an IT Admin hands everything over (the latest hand-over): the IT Admin who took it, and how many of each were moved.
  doneAt                DateTime? @map("done_at") @db.Timestamptz(3)
  doneToEmployeeId      String?   @map("done_to_employee_id") @db.Uuid
  doneSubscriptions     Int?      @map("done_subscriptions")
  doneApplications      Int?      @map("done_applications")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  offboardingCase    OffboardingCase?    @relation(fields: [offboardingCaseId], references: [id], onDelete: Restrict)
  departmentTransfer DepartmentTransfer? @relation(fields: [departmentTransferId], references: [id], onDelete: Restrict)
  doneToEmployee     Employee?           @relation("ItAdminHandoverReceiver", fields: [doneToEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([doneToEmployeeId])
  @@map("it_admin_handovers")
}
