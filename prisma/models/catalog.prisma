enum CatalogApplicationStatus {
  ACTIVE
  INACTIVE
  UNDER_REVIEW
}

model CatalogApplication {
  id        String                   @id @default(uuid()) @db.Uuid
  slug      String                   @unique
  name      String
  vendor    String
  status    CatalogApplicationStatus @default(ACTIVE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@map("catalog_applications")
}
