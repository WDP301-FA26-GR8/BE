# Private input of scripts/ops/bootstrap-installation.sh — the FIRST installation of a database, once.
# This template holds no value and no default credential. On the VPS, copy it to `.env.bootstrap` with owner-only mode,
# fill it there and keep it there (runbook: docs/guides/containers.md, "Bootstrap wrapper"):
#
#   (umask 077 && cp .env.bootstrap.example .env.bootstrap)   # then edit .env.bootstrap on the VPS
#
# Never commit the real file, never copy it into an image or a CI artifact, never paste it into a chat or a ticket.
# It is separate from `.env` (Compose and database credentials) and `.env.app` (API and worker settings).
#
# Syntax. The script reads this file as data: nothing in it is run, expanded or interpreted.
#   - One NAME=VALUE per line, no spaces around `=`, no `export`, no comment after a value.
#   - Blank lines and lines that start with `#` are ignored. Unix (LF) line endings only.
#   - The value is everything after the first `=`, literally: no $variables, no `backticks`, no $(commands), no escapes,
#     no trimming. One pair of matching outer quotes ('...' or "...") is removed, so '  edge spaces  ' keeps its spaces
#     and a value that must start and end with a quote is written inside the other kind of quote.
#   - Each name once; an unknown name, a repeated name or an unbalanced quote stops the script before Docker starts.
#   - A required setting must not be empty. An empty optional setting means "not given" (the command's own default).
#   - The environment is fixed to SHARED by the script: it is not a setting.
#
# The installation command validates every value (real values, not placeholders; the time zone cannot be changed later).

# Required — the organization and its first department
BOOTSTRAP_TIMEZONE=
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_DEPARTMENT_CODE=
BOOTSTRAP_DEPARTMENT_NAME=

# Required — the Super Admin's employee record (hire date: YYYY-MM-DD, not in the future)
BOOTSTRAP_ADMIN_CODE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_HIRE_DATE=

# Required — ticket or approval reference, recorded in the audit trail
BOOTSTRAP_OPERATOR_REFERENCE=

# Required — the Super Admin's password, chosen by the person who will hold the role (12 to 128 characters, not the
# email, spaces are part of it). It is sent to the installation command on standard input only, never as an argument.
# After the installation, keep this file at mode 600 or remove the password line or the file.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional — the command's defaults apply when empty: reporting currency VND, sign-in email = the work email, type STAFF
BOOTSTRAP_CURRENCY=
BOOTSTRAP_LOGIN_EMAIL=
BOOTSTRAP_ADMIN_TYPE=
