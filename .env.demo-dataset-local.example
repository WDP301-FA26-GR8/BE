# Private input of scripts/ops/demo-dataset-local.mjs — the shared demo dataset run from a local checkout (Windows or
# any OS) against the VPS, without a new image: the API over HTTPS, PostgreSQL through an SSH tunnel. Runbook:
# docs/guides/demo-dataset.md (section "Chạy từ máy local").
#
# Copy it OUT of the repository (for example to %USERPROFILE%\slm-demo\.env.demo-dataset-local), fill it there, keep it
# readable by your account only. The wrapper refuses a file Git would commit. Never paste it into a chat or a ticket.
#
# Syntax (read as data, nothing in it is run or expanded): one NAME=VALUE per line, no spaces around `=`; blank lines and
# lines starting with `#` are ignored; LF or CRLF; each name once; one pair of matching outer quotes is removed.

# Required — the dataset version and the installation it is written into (the organization name, exactly)
DEMO_FIXTURE=shared-demo-v1
DEMO_ORGANIZATION_NAME=

# Required — who runs it: a ticket or approval reference, kept in the Audit Trail (never a password)
DEMO_OPERATOR_REFERENCE=

# Required — the public HTTPS origin of the API on the VPS (no path), for example https://api.example.com
DEMO_API_URL=

# Required — SSH to the VPS with a key or an agent (no password prompt), and the deployment directory there
DEMO_SSH_TARGET=
DEMO_REMOTE_APP_DIR=/opt/slm/backend

# Required — the PostgreSQL database and the RUNTIME role the API uses (from DATABASE_URL of the api service on the VPS).
# Never the deploy role or the cluster superuser: the command refuses them.
DEMO_DATABASE_NAME=
DEMO_DATABASE_USER=
DEMO_DATABASE_PASSWORD=

# Required — the password of the installation's Super Admin, and the password every demo account gets (12 to 128
# characters; handed to the FE team privately; a rerun must use the same one). Sent on standard input only.
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_ACCOUNT_PASSWORD=

# Optional — SSH port (22), a key file, the PostgreSQL container on the VPS (slm-postgres), the local end of the tunnel
# (15432, bound to 127.0.0.1 only), and where the reports are kept (default: demo-dataset-reports next to this file)
DEMO_SSH_PORT=
DEMO_SSH_IDENTITY_FILE=
DEMO_POSTGRES_CONTAINER=
DEMO_LOCAL_PORT=
DEMO_REPORT_DIR=
