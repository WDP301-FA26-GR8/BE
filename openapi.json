{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "healthGetLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process is alive.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponseDto" } } }
          },
          "500": {
            "description": "The liveness check could not be completed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "healthGetReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every required dependency is reachable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponseDto" } } }
          },
          "500": {
            "description": "The readiness check could not be completed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "A required dependency is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["health"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "authLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginBodyDto" } } }
        },
        "responses": {
          "200": {
            "description": "Signed in. The refresh token is set as an HttpOnly cookie.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionTokenResponseDto" } } }
          },
          "401": {
            "description": "The email or password is not valid (one answer for every reason).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The request body is invalid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "429": {
            "description": "Too many failed attempts; see retryAfterSeconds.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A new access token; the refresh cookie is rotated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionTokenResponseDto" } } }
          },
          "401": {
            "description": "The session is missing, expired, revoked or replayed. The cookie is cleared.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "parameters": [],
        "responses": {
          "204": { "description": "Signed out (or there was nothing to sign out)." },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/invitations/redeem": {
      "post": {
        "operationId": "authRedeemInvitation",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RedeemInvitationBodyDto" } } }
        },
        "responses": {
          "200": {
            "description": "The account is activated. The user signs in with the login route.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AccountActivatedResponseDto" } }
            }
          },
          "400": {
            "description": "The link is not valid (unknown, used, replaced, expired, or the account cannot be activated).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The body is invalid or the password does not meet the policy.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "meGet",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The signed-in account, its employee record and its effective roles.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "Authentication or the service is temporarily unavailable (TOKEN_VERIFICATION_UNAVAILABLE from the guard, SERVICE_UNAVAILABLE after it).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["me"]
      }
    },
    "/api/v1/account-candidates": {
      "get": {
        "operationId": "accountCandidatesList",
        "parameters": [
          { "name": "search", "required": false, "in": "query", "schema": { "maxLength": 100, "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Employees who have not left and have no account yet (at most 20).",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AccountCandidatesResponseDto" } }
            }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The query is invalid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users": {
      "post": {
        "operationId": "appUserCreate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAppUserBodyDto" } } }
        },
        "responses": {
          "201": {
            "description": "The account was created (invited) and its invitation queued.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "The employee does not exist.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "The employee left, already has an account, or the email or Finance seat is taken.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The body is invalid or a requested role cannot be granted by hand.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      },
      "get": {
        "operationId": "appUserList",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 9007199254740991,
              "exclusiveMinimum": true,
              "default": 1,
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": { "maximum": 100, "exclusiveMinimum": true, "default": 20, "type": "integer", "minimum": 0 }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "enum": ["ACTIVE", "LOCKED"] }
          },
          {
            "name": "activationState",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "enum": ["INVITED", "ACTIVATED"] }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": { "type": "string", "enum": ["SUPER_ADMIN", "IT_ADMIN", "FINANCE", "EMPLOYEE"] }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of accounts.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountPageResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The query is invalid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}": {
      "get": {
        "operationId": "appUserGet",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account with its role history and invitation state.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No account has this identifier.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The identifier is not a UUID.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}/invitations": {
      "post": {
        "operationId": "appUserResendInvitation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "A new invitation was queued; the previous one no longer works.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No account has this identifier.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "The account is activated, locked, belongs to a departed employee, or is the caller.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The identifier is not a UUID (VALIDATION_ERROR).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}/lock": {
      "post": {
        "operationId": "appUserLock",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account is locked; its sessions and unused invitation are ended.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No account has this identifier.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "The caller, or the holder of SUPER_ADMIN, cannot be locked.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The identifier is not a UUID (VALIDATION_ERROR).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}/unlock": {
      "post": {
        "operationId": "appUserUnlock",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account is active again.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No account has this identifier.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "The caller cannot change their own account.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The identifier is not a UUID (VALIDATION_ERROR).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}/role-grants": {
      "post": {
        "operationId": "appUserGrantRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GrantRoleBodyDto" } } }
        },
        "responses": {
          "201": {
            "description": "The role is granted and takes effect at the account next request.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No account has this identifier.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "Already granted, forbidden combination, Finance seat taken, or the caller.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The role is derived or moves only by transfer.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    },
    "/api/v1/app-users/{id}/role-grants/{role}": {
      "delete": {
        "operationId": "appUserRevokeRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "enum": ["SUPER_ADMIN", "IT_ADMIN", "FINANCE", "EMPLOYEE", "MANAGER", "SPENDING_APPROVER"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The role is revoked (the last role may be revoked); it stops at the next request.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountDetailResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "403": {
            "description": "Only the Super Admin may call this route.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "404": {
            "description": "No such account, or it does not hold this role.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "409": {
            "description": "The caller cannot change their own account.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The role is derived or moves only by transfer.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The service is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["app-users"]
      }
    }
  },
  "info": {
    "title": "Software License Management API",
    "description": "Internal software license and technology cost API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
