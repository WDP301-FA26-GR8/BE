# Private input of scripts/ops/demo-dataset.sh — the shared demo dataset (pnpm ops:demo-dataset) on a VPS.
# This template holds no value and no default credential. On the VPS, copy it to `.env.demo-dataset` with owner-only mode,
# fill it there and keep it there (runbook: docs/guides/demo-dataset.md):
#
#   (umask 077; set -C; cat .env.demo-dataset.example > .env.demo-dataset)   # then edit .env.demo-dataset on the VPS
#
# Never commit the real file, never copy it into an image or a CI artifact, never paste it into a chat or a ticket.
# It is separate from `.env`, `.env.app` and `.env.bootstrap`.
#
# Syntax (read as data, nothing in it is run or expanded): one NAME=VALUE per line, no spaces around `=`, no `export`,
# no comment after a value; blank lines and lines starting with `#` are ignored; LF line endings only; each name once;
# one pair of matching outer quotes is removed. The environment is fixed to SHARED by the script.

# Required — the dataset version and the installation it is written into (the organization name, exactly)
DEMO_FIXTURE=shared-demo-v1
DEMO_ORGANIZATION_NAME=

# Required — who runs it: a ticket or approval reference, kept in the Audit Trail (never a password)
DEMO_OPERATOR_REFERENCE=

# Required — the password of the installation's Super Admin. The command signs in as the Super Admin to write the
# organization data of the dataset through the API (departments, people, heads, approval roles) and to read the Audit
# Trail. It is sent on standard input only. Remove it from this file once the dataset is applied if you prefer.
DEMO_SUPER_ADMIN_PASSWORD=

# Required — the password every demo account gets (12 to 128 characters, not an email). Chosen by the operator, handed to
# the FE team privately, never written in a document. A rerun must use the same one.
DEMO_ACCOUNT_PASSWORD=

# Optional — the API as seen from a one-off container of the Compose network (default http://slm-api:3000, the container
# name and port of docker-compose.prod.yml). Origin only, no path.
DEMO_API_URL=
